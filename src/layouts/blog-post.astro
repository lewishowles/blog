---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";

import DoodleLewis from "@/components/doodles/doodle-lewis.astro";
import FormattedDate from "@/components/helpers/formatted-date.astro";
import Page from "@/layouts/page.astro";
import TableOfContents from "@/components/blog/table-of-contents.astro";

type Props = CollectionEntry<"blog">["data"] & { headings: MarkdownHeading[] };

const { title, description, headings, pubDate, updatedDate } = Astro.props;
---

<Page title={title} description={description}>
	<article class="prose prose-slate dark:prose-invert max-w-none">
		<div class="flex gap-4 mb-2 text-colour-muted">
			<FormattedDate date={pubDate} />

			{
				updatedDate && (
					<span>•</span>

					<div>
						Last updated: <FormattedDate date={updatedDate} />
					</div>
				)
			}
		</div>

		<h1>{title}</h1>

		<div class="grid grid-cols-1 gap-22 lg:grid-cols-[1fr_20rem]">
			<div>
				<slot />

				<DoodleLewis class="size-auto text-colour-link" />
			</div>

			<aside class="not-prose">
				<TableOfContents headings={headings} />
			</aside>
		</div>
	</article>
</Page>
