---
import type { MarkdownHeading } from "astro";

export interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// We choose to only show second and third level headings in our contents.
// Anything more might end up being noise.
const visibleHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{visibleHeadings.length > 0 && (
	<nav>
		<h2 class="mb-4 font-bold text-(--text-colour-title)">On this page</h2>

		<ol class="flex flex-col gap-2">
			{visibleHeadings.map(({ depth, slug, text }) => (
				<li class:list={[{ "pl-2": depth === 3 }]}>
					<a href={`#${slug}`} class="text-current">{text}</a>
				</li>
			))}
		</ol>
	</nav>
)}
